# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Quote form delivery (Resend — https://resend.com).
# Until all three are set, /api/quote responds 503 and the form tells the
# buyer the integration is not connected. It never shows a fake success.
RESEND_API_KEY=
# Inbox that receives quote requests.
QUOTE_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Noxel Apparel <quotes@yourdomain.com>".
QUOTE_FROM_EMAIL=
